# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=sigmapro_db
# Réplicas de lectura (separadas por coma). Vacío = sin replicación (dev local).
# Ej: DB_REPLICA_HOSTS=mysql-replica-1,mysql-replica-2
DB_REPLICA_HOSTS=
# Sincronización de esquema (TypeORM). Dejar true salvo en producción con migraciones.
DB_SYNCHRONIZE=true

# Identidad de la instancia (para demostrar el balanceo de carga)
INSTANCE_ID=local
# true detrás de un balanceador (HAProxy/nginx) para conocer la IP real del cliente
TRUST_PROXY=false

# Redis (for BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# SMTP Email Configuration — recuperación de contraseña por correo
# Gmail: 1) activa la verificación en 2 pasos, 2) genera una "Contraseña de App" en
#        https://myaccount.google.com/apppasswords (16 caracteres) y úsala en SMTP_PASS.
#        SMTP_USER = tu correo Gmail. SMTP_PASS NUNCA es tu contraseña normal de Google.
# Sin credenciales, el backend usa una cuenta Ethereal de prueba: el correo NO llega
# a la bandeja real (solo se ve un preview en el log del backend).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_de_16_caracteres
SMTP_FROM="SIGMAPRO <tu_email@gmail.com>"

# Frontend URL (base de los enlaces del correo, ej: https://tudominio.cl)
FRONTEND_URL=http://localhost:4200

# CORS
CORS_ORIGIN=http://localhost:4200

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# App
PORT=3003
NODE_ENV=development